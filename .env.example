# Smart Notification Router - Environment Variables
# Copy this to .env and fill in your values

# ── Wooxy Email API ──
WOOXY_API_KEY=your_wooxy_api_key_here
WOOXY_FROM_EMAIL=noreply@yourdomain.com
WOOXY_FROM_NAME=Smart Notif Router

# ── Redis (BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Database ──
DB_PATH=./data/notifications.db

# ── AI ──
AI_ENABLED=true

# ── Server ──
PORT=3001
NODE_ENV=development

# ── Auth & CORS ──
# Static Bearer token required for mutating routes (create/retry/delete).
# If unset, those routes FAIL CLOSED with 503 (never open).
API_KEY=changeme-set-a-strong-token
# Comma-separated allowlist of browser origins for CORS.
# Defaults to http://localhost:3001 when unset.
CORS_ORIGINS=http://localhost:3001
